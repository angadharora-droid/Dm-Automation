# ── Server ────────────────────────────────────────────────────────────────────
# Railway injects PORT automatically; leave unset there. Default locally: 3000
PORT=3000
NODE_ENV=development

# ── Meta app credentials (App Dashboard → App settings → Basic) ───────────────
META_APP_ID=
META_APP_SECRET=

# Any random string you choose. You must enter the SAME value in the Meta App
# Dashboard webhook configuration ("Verify token").
META_VERIFY_TOKEN=

# ── Instagram professional account ────────────────────────────────────────────
# Instagram User access token (from App Dashboard → Instagram → API setup with
# Instagram login → generate token, or via the Instagram Login flow).
INSTAGRAM_ACCESS_TOKEN=

# Your Instagram professional account ID (the app user's IG ID). If unset, the
# API falls back to /me, but setting it explicitly is required for reliable
# self-message loop protection.
INSTAGRAM_ACCOUNT_ID=

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Connection string (MongoDB Atlas or the Railway MongoDB service), e.g.
# mongodb+srv://user:pass@cluster.mongodb.net or mongodb://mongo:port
# Unset = in-memory fallback stores (fine for local dev; events reset on restart).
MONGODB_URI=
# Database name (default: instagram_automation)
# MONGODB_DB=instagram_automation

# ── Meta API ──────────────────────────────────────────────────────────────────
# Graph API version, e.g. v25.0 (default). Check https://developers.facebook.com/docs/graph-api/changelog
META_API_VERSION=v25.0
# Base URL for the Instagram API with Instagram Login. Default: https://graph.instagram.com
# META_GRAPH_BASE_URL=https://graph.instagram.com

# ── Optional ──────────────────────────────────────────────────────────────────
# Admin auth — the dashboard/admin endpoints are enabled when at least one of
# these methods is configured (both can be set at the same time):
#
# 1. API key (curl/scripts, or "advanced" sign-in on the dashboard):
ADMIN_API_KEY=
# 2. Dashboard login with a login ID + password:
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Secret for signing login session tokens. Optional — falls back to
# META_APP_SECRET. Set it if you ever rotate the app secret independently.
# SESSION_SECRET=

# debug | info | warn | error (default: info)
LOG_LEVEL=info

# Path to the built React dashboard served at /dashboard.
# Default: the sibling ../frontend/dist folder — only set this for custom layouts.
# FRONTEND_DIR=

# Outbound Meta API request timeout in milliseconds (default: 10000)
# REQUEST_TIMEOUT_MS=10000

# Max webhook request body size (default: 1mb)
# WEBHOOK_BODY_LIMIT=1mb

# Comma-separated list of allowed CORS origins for browser clients.
# Webhooks do not need CORS; leave unset to disallow cross-origin browser calls.
# ALLOWED_ORIGINS=

# Override the default automation rules with JSON (see README "Automation rules").
# AUTOMATION_RULES=
